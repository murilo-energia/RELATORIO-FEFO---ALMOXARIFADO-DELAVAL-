<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Controle de Vencimento de Produtos - Grupo Energia</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- PapaParse para ler CSV -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.3.2/papaparse.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
        }
        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #0f172a;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <!-- MODAL DE LOGIN -->
    <div id="loginModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-md">
        <div class="glass-card p-8 rounded-2xl w-full max-w-md shadow-2xl border border-slate-700/50">
            <div class="text-center mb-6">
                <div class="w-16 h-16 bg-blue-600/20 text-blue-400 rounded-full flex items-center justify-center mx-auto mb-3 border border-blue-500/30">
                    <i class="fa-solid fa-boxes-stacked text-2xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-white">Controle de Estoque</h2>
                <p class="text-xs text-slate-400 mt-1">Gestão e Validade de Produtos</p>
            </div>
            <form id="loginForm" onsubmit="handleLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-medium text-slate-300 mb-1">Perfil de Acesso</label>
                    <select id="userRole" class="w-full bg-slate-900/90 border border-slate-700 text-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
                        <option value="viewer">Visualizador (Apenas Leitura)</option>
                        <option value="admin">Administrador (Acesso Completo)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-300 mb-1">Senha de Acesso</label>
                    <input type="password" id="userPass" class="w-full bg-slate-900/90 border border-slate-700 text-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500" placeholder="Digite sua senha" required>
                </div>
                <p id="loginError" class="text-red-400 text-xs hidden text-center"><i class="fa-solid fa-triangle-exclamation mr-1"></i> Senha incorreta.</p>
                <button type="submit" class="w-full py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-lg shadow-lg shadow-blue-600/30 transition-all text-sm">
                    Entrar no Sistema
                </button>
            </form>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div id="mainContent" class="hidden flex-1 flex flex-col">
        <!-- TOP NAV -->
        <header class="glass-card sticky top-0 z-40 border-b border-slate-800 px-6 py-4 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-blue-600/20 text-blue-400 rounded-lg border border-blue-500/30">
                    <i class="fa-solid fa-boxes-stacked text-xl"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold text-white leading-tight">Controle de Vencimento de Produtos</h1>
                    <p class="text-xs text-slate-400">SESMT / Logística — Grupo Energia</p>
                </div>
            </div>

            <div class="flex items-center gap-3 w-full md:w-auto justify-end">
                <button onclick="fetchData()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium rounded-lg border border-slate-700 flex items-center gap-2 transition-all">
                    <i class="fa-solid fa-rotate" id="refreshIcon"></i> Sincronizar
                </button>
                <a id="sheetLinkBtn" href="#" target="_blank" class="hidden px-3 py-1.5 bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-400 text-xs font-medium rounded-lg border border-emerald-500/30 flex items-center gap-2 transition-all">
                    <i class="fa-solid fa-file-excel"></i> Editar Planilha
                </a>
                <span id="roleBadge" class="px-2.5 py-1 text-[11px] font-semibold rounded-full bg-slate-800 text-slate-300 border border-slate-700">
                    Visualizador
                </span>
                <button onclick="logout()" class="p-2 text-slate-400 hover:text-red-400 transition-colors">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </button>
            </div>
        </header>

        <!-- CONTAINER -->
        <main class="p-6 max-w-7xl mx-auto w-full space-y-6 flex-1">
            
            <!-- FILTROS -->
            <section class="glass-card p-4 rounded-xl border border-slate-800 flex flex-wrap gap-4 items-center justify-between">
                <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
                    <!-- Busca Global -->
                    <div class="relative flex-1 sm:w-64">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-500 text-xs"></i>
                        <input type="text" id="searchInput" oninput="applyFilters()" placeholder="Buscar por código, item ou lote..." class="w-full bg-slate-900 border border-slate-700 rounded-lg pl-8 pr-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-blue-500">
                    </div>
                    
                    <!-- Filtro Filial -->
                    <select id="filterFilial" onchange="applyFilters()" class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-blue-500">
                        <option value="">Todas as Filiais</option>
                    </select>

                    <!-- Filtro Status -->
                    <select id="filterStatus" onchange="applyFilters()" class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-blue-500">
                        <option value="">Todos os Status</option>
                        <option value="VENCIDO">🔴 Vencidos</option>
                        <option value="ALERTA">🟡 Alerta (≤ 60 Dias)</option>
                        <option value="OK">🟢 OK (Em dia)</option>
                    </select>
                </div>

                <div class="text-xs text-slate-400 flex items-center gap-2">
                    <span>Exibindo: <strong id="itemsCount" class="text-slate-200">0</strong> de <strong id="totalCount" class="text-slate-200">0</strong> registros</span>
                </div>
            </section>

            <!-- KPIS METRICS -->
            <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Vencidos -->
                <div class="glass-card p-4 rounded-xl border border-red-500/20 bg-gradient-to-br from-red-500/10 via-transparent to-transparent">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs text-slate-400 font-medium">Produtos Vencidos</p>
                            <h3 class="text-2xl font-bold text-red-400 mt-1" id="kpiVencidos">0</h3>
                        </div>
                        <div class="p-2 bg-red-500/20 text-red-400 rounded-lg border border-red-500/30">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>
                    </div>
                    <p class="text-[11px] text-slate-500 mt-2">Ação imediata necessária</p>
                </div>

                <!-- Alerta 60 Dias -->
                <div class="glass-card p-4 rounded-xl border border-amber-500/20 bg-gradient-to-br from-amber-500/10 via-transparent to-transparent">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs text-slate-400 font-medium">Alerta (≤ 60 Dias)</p>
                            <h3 class="text-2xl font-bold text-amber-400 mt-1" id="kpiAlerta">0</h3>
                        </div>
                        <div class="p-2 bg-amber-500/20 text-amber-400 rounded-lg border border-amber-500/30">
                            <i class="fa-solid fa-clock"></i>
                        </div>
                    </div>
                    <p class="text-[11px] text-slate-500 mt-2">Próximos do vencimento</p>
                </div>

                <!-- Produtos OK -->
                <div class="glass-card p-4 rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/10 via-transparent to-transparent">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs text-slate-400 font-medium">Produtos OK</p>
                            <h3 class="text-2xl font-bold text-emerald-400 mt-1" id="kpiOK">0</h3>
                        </div>
                        <div class="p-2 bg-emerald-500/20 text-emerald-400 rounded-lg border border-emerald-500/30">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                    </div>
                    <p class="text-[11px] text-slate-500 mt-2">Dentro do prazo seguro</p>
                </div>

                <!-- Total Estoque -->
                <div class="glass-card p-4 rounded-xl border border-blue-500/20 bg-gradient-to-br from-blue-500/10 via-transparent to-transparent">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs text-slate-400 font-medium">Volume Total em Estoque</p>
                            <h3 class="text-2xl font-bold text-blue-400 mt-1" id="kpiEstoque">0</h3>
                        </div>
                        <div class="p-2 bg-blue-500/20 text-blue-400 rounded-lg border border-blue-500/30">
                            <i class="fa-solid fa-cubes"></i>
                        </div>
                    </div>
                    <p class="text-[11px] text-slate-500 mt-2">Soma de itens armazenados</p>
                </div>
            </section>

            <!-- CHARTS SECTION -->
            <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Status por Filial -->
                <div class="glass-card p-5 rounded-xl border border-slate-800">
                    <h3 class="text-sm font-semibold text-white mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-chart-bar text-blue-400"></i> Distribuição por Filial
                    </h3>
                    <div class="relative h-64">
                        <canvas id="chartFiliais"></canvas>
                    </div>
                </div>

                <!-- Curva de Vencimentos -->
                <div class="glass-card p-5 rounded-xl border border-slate-800">
                    <h3 class="text-sm font-semibold text-white mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-chart-line text-amber-400"></i> Cronograma de Vencimentos (Próximos Meses)
                    </h3>
                    <div class="relative h-64">
                        <canvas id="chartVencimentos"></canvas>
                    </div>
                </div>
            </section>

            <!-- TABELA DE DADOS -->
            <section class="glass-card rounded-xl border border-slate-800 overflow-hidden">
                <div class="p-4 border-b border-slate-800 flex justify-between items-center">
                    <h3 class="text-sm font-semibold text-white flex items-center gap-2">
                        <i class="fa-solid fa-list-check text-slate-400"></i> Relatório Detalhado de Produtos
                    </h3>
                </div>
                <div class="overflow-x-auto custom-scrollbar">
                    <table class="w-full text-left text-xs text-slate-300">
                        <thead class="bg-slate-900/80 text-slate-400 uppercase tracking-wider font-semibold border-b border-slate-800">
                            <tr>
                                <th class="p-3">Código</th>
                                <th class="p-3">Descrição do Produto</th>
                                <th class="p-3">Filial</th>
                                <th class="p-3">Localização</th>
                                <th class="p-3 text-right">Estoque</th>
                                <th class="p-3">Lote</th>
                                <th class="p-3">Fabricação</th>
                                <th class="p-3">Vencimento</th>
                                <th class="p-3 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody" class="divide-y divide-slate-800/50">
                            <!-- Inserido dinamicamente via JS -->
                        </tbody>
                    </table>
                </div>
            </section>
        </main>

        <!-- FOOTER -->
        <footer class="p-4 text-center text-xs text-slate-500 border-t border-slate-900">
            Grupo Energia &copy; 2026 — Sistema Interno de Controle de Validade
        </footer>
    </div>

    <!-- JAVASCRIPT APP LOGIC -->
    <script>
        // CONFIGURAÇÕES GERAIS E SEGURANÇA
        const CONFIG = {
            // URL do CSV Publicado da Planilha Google Sheets
            csvUrl: "https://docs.google.com/spreadsheets/d/e/2PACX-1vT5K76P3W0YlR7c8T4Q9Z7-YOUR-PUBLISHED-CSV-URL/pub?output=csv",
            // Link direto para edição da planilha (visível apenas para Administrador)
            sheetDirectLink: "https://docs.google.com/spreadsheets/d/YOUR-SPREADSHEET-ID/edit",
            passwords: {
                viewer: "1234",
                admin: "admin123"
            }
        };

        let rawData = [];
        let filteredData = [];
        let chartFiliaisInstance = null;
        let chartVencimentosInstance = null;

        // AUTH & PERFIS
        function handleLogin(e) {
            e.preventDefault();
            const role = document.getElementById('userRole').value;
            const pass = document.getElementById('userPass').value;
            const errorEl = document.getElementById('loginError');

            if (pass === CONFIG.passwords[role]) {
                localStorage.setItem('auth_role', role);
                errorEl.classList.add('hidden');
                initApp(role);
            } else {
                errorEl.classList.remove('hidden');
            }
        }

        function logout() {
            localStorage.removeItem('auth_role');
            location.reload();
        }

        function checkAuth() {
            const role = localStorage.getItem('auth_role');
            if (role) {
                initApp(role);
            }
        }

        function initApp(role) {
            document.getElementById('loginModal').classList.add('hidden');
            document.getElementById('mainContent').classList.remove('hidden');
            
            const badge = document.getElementById('roleBadge');
            const sheetBtn = document.getElementById('sheetLinkBtn');

            if (role === 'admin') {
                badge.textContent = 'Administrador';
                badge.className = 'px-2.5 py-1 text-[11px] font-semibold rounded-full bg-blue-600/20 text-blue-400 border border-blue-500/30';
                sheetBtn.href = CONFIG.sheetDirectLink;
                sheetBtn.classList.remove('hidden');
            } else {
                badge.textContent = 'Visualizador';
                badge.className = 'px-2.5 py-1 text-[11px] font-semibold rounded-full bg-slate-800 text-slate-300 border border-slate-700';
                sheetBtn.classList.add('hidden');
            }

            fetchData();
        }

        // CARREGAMENTO DE DADOS (PAPAPARSE)
        function fetchData() {
            const icon = document.getElementById('refreshIcon');
            if(icon) icon.classList.add('fa-spin');

            Papa.parse(CONFIG.csvUrl, {
                download: true,
                header: true,
                skipEmptyLines: true,
                complete: function(results) {
                    if(icon) icon.classList.remove('fa-spin');
                    processData(results.data);
                },
                error: function(err) {
                    if(icon) icon.classList.remove('fa-spin');
                    alert("Erro ao sincronizar com o Google Sheets. Verifique o link público CSV.");
                }
            });
        }

        // PROCESSAMENTO DE DADOS
        function processData(data) {
            rawData = data.map((row, index) => {
                const estoqueVal = parseFloat((row['ESTOQUE'] || '0').replace(',', '.')) || 0;
                const statusCalculado = calculateStatus(row['VENCIMENTO'], row['VENCIMENTO (STATUS)']);

                return {
                    id: index,
                    codigo: row['CÓDIGO'] || 'N/A',
                    descricao: row['DESCRIÇÃO DO PRODUTO'] || 'Sem Descrição',
                    filial: row['FILIAL'] || 'Não Definida',
                    localizacao: row['LOCALIZAÇÃO'] || '-',
                    estoque: estoqueVal,
                    lote: row['LOTE'] || '-',
                    fabricacao: row['FAB'] || '-',
                    vencimento: row['VENCIMENTO'] || '-',
                    status: statusCalculado
                };
            });

            populateDropdowns();
            applyFilters();
        }

        // CÁLCULO DE STATUS BASEADO NA DATA DE VENCIMENTO
        function calculateStatus(dataVenc, statusPlanilha) {
            if (statusPlanilha) {
                const upper = statusPlanilha.toUpperCase();
                if (upper.includes('VENCIDO')) return 'VENCIDO';
                if (upper.includes('ALERTA') || upper.includes('60')) return 'ALERTA';
                if (upper.includes('OK')) return 'OK';
            }

            if (!dataVenc || dataVenc === '-') return 'OK';

            // Tratamento de data PT-BR (DD/MM/YYYY)
            const parts = dataVenc.split('/');
            if (parts.length === 3) {
                const vencDate = new Date(parts[2], parts[1] - 1, parts[0]);
                const hoje = new Date();
                const diffTime = vencDate - hoje;
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

                if (diffDays < 0) return 'VENCIDO';
                if (diffDays <= 60) return 'ALERTA';
                return 'OK';
            }

            return 'OK';
        }

        // POPULAR FILTROS
        function populateDropdowns() {
            const filiais = [...new Set(rawData.map(item => item.filial))].sort();
            const select = document.getElementById('filterFilial');
            select.innerHTML = '<option value="">Todas as Filiais</option>';
            filiais.forEach(f => {
                select.innerHTML += `<option value="${f}">${f}</option>`;
            });
        }

        // APLICAÇÃO DE FILTROS
        function applyFilters() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const filial = document.getElementById('filterFilial').value;
            const status = document.getElementById('filterStatus').value;

            filteredData = rawData.filter(item => {
                const matchSearch = item.codigo.toLowerCase().includes(search) || 
                                    item.descricao.toLowerCase().includes(search) || 
                                    item.lote.toLowerCase().includes(search);
                const matchFilial = !filial || item.filial === filial;
                const matchStatus = !status || item.status === status;

                return matchSearch && matchFilial && matchStatus;
            });

            updateUI();
        }

        // ATUALIZAÇÃO DA INTERFACE
        function updateUI() {
            document.getElementById('itemsCount').textContent = filteredData.length;
            document.getElementById('totalCount').textContent = rawData.length;

            updateKPIs();
            renderTable();
            renderCharts();
        }

        // REGRAS DOS KPIS
        function updateKPIs() {
            let vencidos = 0, alerta = 0, ok = 0, totalEstoque = 0;

            filteredData.forEach(item => {
                if (item.status === 'VENCIDO') vencidos++;
                else if (item.status === 'ALERTA') alerta++;
                else ok++;

                totalEstoque += item.estoque;
            });

            document.getElementById('kpiVencidos').textContent = vencidos;
            document.getElementById('kpiAlerta').textContent = alerta;
            document.getElementById('kpiOK').textContent = ok;
            document.getElementById('kpiEstoque').textContent = totalEstoque.toLocaleString('pt-BR');
        }

        // RENDERIZAÇÃO DA TABELA
        function renderTable() {
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '';

            if (filteredData.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="p-6 text-center text-slate-500">Nenhum produto encontrado.</td></tr>`;
                return;
            }

            filteredData.forEach(item => {
                let badgeClass = '';
                let badgeText = item.status;

                if (item.status === 'VENCIDO') {
                    badgeClass = 'bg-red-500/20 text-red-400 border-red-500/30';
                } else if (item.status === 'ALERTA') {
                    badgeClass = 'bg-amber-500/20 text-amber-400 border-amber-500/30';
                } else {
                    badgeClass = 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30';
                }

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-800/40 transition-colors">
                        <td class="p-3 font-mono font-medium text-slate-200">${item.codigo}</td>
                        <td class="p-3 font-medium text-slate-100">${item.descricao}</td>
                        <td class="p-3">${item.filial}</td>
                        <td class="p-3 text-slate-400">${item.localizacao}</td>
                        <td class="p-3 text-right font-semibold text-slate-200">${item.estoque.toLocaleString('pt-BR')}</td>
                        <td class="p-3 font-mono text-slate-400">${item.lote}</td>
                        <td class="p-3 text-slate-400">${item.fabricacao}</td>
                        <td class="p-3 font-medium text-slate-200">${item.vencimento}</td>
                        <td class="p-3 text-center">
                            <span class="px-2 py-0.5 text-[10px] font-bold rounded-full border ${badgeClass}">
                                ${badgeText}
                            </span>
                        </td>
                    </tr>
                `;
            });
        }

        // GRÁFICOS INTERATIVOS
        function renderCharts() {
            // Chart 1: Status por Filial
            const filiaisList = [...new Set(filteredData.map(i => i.filial))];
            const dataVencidos = filiaisList.map(f => filteredData.filter(i => i.filial === f && i.status === 'VENCIDO').length);
            const dataAlerta = filiaisList.map(f => filteredData.filter(i => i.filial === f && i.status === 'ALERTA').length);
            const dataOK = filiaisList.map(f => filteredData.filter(i => i.filial === f && i.status === 'OK').length);

            if (chartFiliaisInstance) chartFiliaisInstance.destroy();
            const ctx1 = document.getElementById('chartFiliais').getContext('2d');
            chartFiliaisInstance = new Chart(ctx1, {
                type: 'bar',
                data: {
                    labels: filiaisList,
                    datasets: [
                        { label: 'Vencidos', data: dataVencidos, backgroundColor: '#ef4444' },
                        { label: 'Alerta', data: dataAlerta, backgroundColor: '#f59e0b' },
                        { label: 'OK', data: dataOK, backgroundColor: '#10b981' }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#94a3b8' } } },
                    scales: {
                        x: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } },
                        y: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } }
                    }
                }
            });

            // Chart 2: Cronograma Mensal de Vencimentos
            const monthsMap = {};
            filteredData.forEach(item => {
                if(item.vencimento && item.vencimento.includes('/')) {
                    const parts = item.vencimento.split('/');
                    if(parts.length === 3) {
                        const key = `${parts[1]}/${parts[2]}`;
                        monthsMap[key] = (monthsMap[key] || 0) + 1;
                    }
                }
            });

            const monthLabels = Object.keys(monthsMap).slice(0, 8);
            const monthCounts = monthLabels.map(m => monthsMap[m]);

            if (chartVencimentosInstance) chartVencimentosInstance.destroy();
            const ctx2 = document.getElementById('chartVencimentos').getContext('2d');
            chartVencimentosInstance = new Chart(ctx2, {
                type: 'line',
                data: {
                    labels: monthLabels,
                    datasets: [{
                        label: 'Produtos a Vencer',
                        data: monthCounts,
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        fill: true,
                        tension: 0.3
                    }]
                },
